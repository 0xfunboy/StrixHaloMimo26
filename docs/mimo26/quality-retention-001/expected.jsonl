{"case_id": "CODE-01", "check_input_immutability": true, "counterexample": "def merge_intervals(intervals):\n    return sorted(intervals)\n", "critical_rule": [], "function": "merge_intervals", "kind": "code", "reference_code": "def merge_intervals(intervals):\n    if any(a > b for a,b in intervals):\n        raise ValueError(\"bounds\")\n    out=[]\n    for a,b in sorted((a,b) for a,b in intervals if a < b):\n        if out and a <= out[-1][1]:\n            out[-1][1]=max(out[-1][1],b)\n        else:\n            out.append([a,b])\n    return out\n", "reference_token_count": 89, "tests": [{"args": [[]], "expected": []}, {"args": [[[5, 7], [1, 3], [3, 5], [2, 4], [9, 9]]], "expected": [[1, 7]]}, {"args": [[[-5, -2], [-3, 1], [4, 8], [4, 5]]], "expected": [[-5, 1], [4, 8]]}, {"args": [[[1, 1], [0, 0]]], "expected": []}, {"args": [[[3, 2]]], "raises": "ValueError"}, {"args": [[[0, 2], [1, 9], [11, 12]]], "expected": [[0, 9], [11, 12]]}]}
{"case_id": "CODE-02", "check_input_immutability": true, "counterexample": "def dedupe_events(events):\n    return list({e[\"id\"]:dict(e) for e in events}.values())\n", "critical_rule": [], "function": "dedupe_events", "kind": "code", "reference_code": "def dedupe_events(events):\n    order=[]\n    best={}\n    for e in events:\n        key=e[\"id\"]\n        if key not in best:\n            order.append(key)\n            best[key]=e\n        elif e[\"version\"] > best[key][\"version\"]:\n            best[key]=e\n    return [dict(best[k]) for k in order]\n", "reference_token_count": 72, "tests": [{"args": [[]], "expected": []}, {"args": [[{"id": "z", "value": "old", "version": 1}, {"id": "a", "value": 8, "version": 3}, {"id": "z", "value": "first", "version": 2}, {"id": "z", "value": "tie", "version": 2}]], "expected": [{"id": "z", "value": "first", "version": 2}, {"id": "a", "value": 8, "version": 3}]}, {"args": [[{"id": "q", "value": null, "version": 5}, {"id": "q", "value": 1, "version": 4}]], "expected": [{"id": "q", "value": null, "version": 5}]}, {"args": [[{"id": "b", "value": [1], "version": -2}, {"id": "b", "value": [2], "version": -1}]], "expected": [{"id": "b", "value": [2], "version": -1}]}]}
{"case_id": "CODE-03", "check_input_immutability": true, "counterexample": "def allocate_cents(total, weights):\n    return [round(total*w/sum(weights)) for w in weights]\n", "critical_rule": [], "function": "allocate_cents", "kind": "code", "reference_code": "def allocate_cents(total, weights):\n    if total < 0 or not weights or any(w < 0 for w in weights) or sum(weights)==0:\n        raise ValueError(\"invalid\")\n    s=sum(weights)\n    out=[total*w//s for w in weights]\n    order=sorted(range(len(weights)), key=lambda i: (-(total*weights[i]%s),i))\n    for i in order[:total-sum(out)]:\n        out[i]+=1\n    return out\n", "reference_token_count": 101, "tests": [{"args": [10, [1, 1, 1]], "expected": [4, 3, 3]}, {"args": [2, [0, 1, 1, 1]], "expected": [0, 1, 1, 0]}, {"args": [0, [2, 3]], "expected": [0, 0]}, {"args": [7, [1, 2, 4]], "expected": [1, 2, 4]}, {"args": [9007199254740993, [1, 1]], "expected": [4503599627370497, 4503599627370496]}, {"args": [-1, [1]], "raises": "ValueError"}, {"args": [1, []], "raises": "ValueError"}, {"args": [3, [0, 0]], "raises": "ValueError"}, {"args": [3, [2, -1]], "raises": "ValueError"}]}
{"case_id": "CODE-04", "check_input_immutability": true, "counterexample": "def validate_batch(records):\n    return {\"valid\":[r[\"id\"] for r in records],\"errors\":[]}\n", "critical_rule": [], "function": "validate_batch", "kind": "code", "reference_code": "def validate_batch(records):\n    valid=[]\n    errors=[]\n    for i,r in enumerate(records):\n        c=[]\n        if not isinstance(r.get(\"id\"),str) or not r[\"id\"].strip(): c.append(\"id\")\n        if type(r.get(\"count\")) is not int or r[\"count\"] < 0: c.append(\"count\")\n        if \"enabled\" in r and type(r[\"enabled\"]) is not bool: c.append(\"enabled\")\n        if any(k not in (\"id\",\"count\",\"enabled\") for k in r): c.append(\"extra\")\n        if c: errors.append({\"index\":i,\"codes\":c})\n        else: valid.append(r[\"id\"].strip())\n    return {\"valid\":valid,\"errors\":errors}\n", "reference_token_count": 153, "tests": [{"args": [[]], "expected": {"errors": [], "valid": []}}, {"args": [[{"count": 0, "enabled": false, "id": " a "}, {"count": 3, "id": "a"}]], "expected": {"errors": [], "valid": ["a", "a"]}}, {"args": [[{"count": true, "enabled": 0, "id": " ", "x": 3}]], "expected": {"errors": [{"codes": ["id", "count", "enabled", "extra"], "index": 0}], "valid": []}}, {"args": [[{}, {"count": -1, "id": "b"}, {"count": 1, "id": 9}]], "expected": {"errors": [{"codes": ["id", "count"], "index": 0}, {"codes": ["count"], "index": 1}, {"codes": ["id"], "index": 2}], "valid": []}}, {"args": [[{"count": 2.0, "id": "z"}]], "expected": {"errors": [{"codes": ["count"], "index": 0}], "valid": []}}]}
{"case_id": "DEBUG-01", "check_input_immutability": true, "counterexample": "def parse_pairs(text):\n    return dict(p.split(\"=\") for p in text.split(\";\") if p.strip())\n", "critical_rule": [], "function": "parse_pairs", "kind": "code", "reference_code": "def parse_pairs(text):\n    out={}\n    for part in text.split(\";\"):\n        if not part.strip(): continue\n        if \"=\" not in part: raise ValueError(\"equals\")\n        k,v=part.split(\"=\",1)\n        k=k.strip()\n        if not k: raise ValueError(\"key\")\n        out[k]=v.strip()\n    return out\n", "reference_token_count": 72, "tests": [{"args": [""], "expected": {}}, {"args": [" ; a = one=two ; b= ; a=last ; "], "expected": {"a": "last", "b": ""}}, {"args": ["token=a=b=c"], "expected": {"token": "a=b=c"}}, {"args": ["bad"], "raises": "ValueError"}, {"args": [" =x"], "raises": "ValueError"}, {"args": ["x=y; broken"], "raises": "ValueError"}]}
{"case_id": "DEBUG-02", "check_input_immutability": true, "counterexample": "def counter_delta(before,after):\n    return {\"status\":\"ok\",\"delta\":{k:max(0,after.get(k,0)-before.get(k,0)) for k in (\"read_bytes\",\"majflt\")}}\n", "critical_rule": [], "function": "counter_delta", "kind": "code", "reference_code": "def counter_delta(before,after):\n    keys=(\"read_bytes\",\"majflt\")\n    for d in (before,after):\n        if any(type(d.get(k)) is not int or d[k]<0 for k in keys):\n            raise ValueError(\"counter\")\n    if any(after[k]<before[k] for k in keys):\n        return {\"status\":\"reset\",\"delta\":None}\n    return {\"status\":\"ok\",\"delta\":{k:after[k]-before[k] for k in keys}}\n", "reference_token_count": 100, "tests": [{"args": [{"majflt": 1, "read_bytes": 10}, {"majflt": 3, "read_bytes": 14}], "expected": {"delta": {"majflt": 2, "read_bytes": 4}, "status": "ok"}}, {"args": [{"majflt": 1, "read_bytes": 10}, {"majflt": 2, "read_bytes": 9}], "expected": {"delta": null, "status": "reset"}}, {"args": [{"majflt": 2, "read_bytes": 0}, {"majflt": 2, "read_bytes": 0}], "expected": {"delta": {"majflt": 0, "read_bytes": 0}, "status": "ok"}}, {"args": [{}, {"majflt": 0, "read_bytes": 1}], "raises": "ValueError"}, {"args": [{"majflt": 0, "read_bytes": true}, {"majflt": 0, "read_bytes": 1}], "raises": "ValueError"}, {"args": [{"majflt": 0, "read_bytes": -1}, {"majflt": 0, "read_bytes": 1}], "raises": "ValueError"}]}
{"case_id": "DEBUG-03", "check_input_immutability": true, "counterexample": "def retry_decision(attempt,max_attempts,error,idempotent):\n    retry=attempt<=max_attempts and error==\"timeout\" or idempotent\n    return {\"retry\":retry,\"delay\":2**attempt}\n", "critical_rule": [{"indices": [1, 2, 3], "kind": "code_test", "meaning": "retry forbidden or non-idempotent operation"}], "function": "retry_decision", "kind": "code", "reference_code": "def retry_decision(attempt,max_attempts,error,idempotent):\n    yes=attempt<max_attempts and error in (\"timeout\",\"temporary\") and idempotent\n    return {\"retry\":yes,\"delay\":min(30,2**(attempt-1)) if yes else 0}\n", "reference_token_count": 58, "tests": [{"args": [1, 3, "timeout", true], "expected": {"delay": 1, "retry": true}}, {"args": [3, 3, "timeout", true], "expected": {"delay": 0, "retry": false}}, {"args": [1, 3, "permanent", true], "expected": {"delay": 0, "retry": false}}, {"args": [1, 3, "timeout", false], "expected": {"delay": 0, "retry": false}}, {"args": [7, 9, "temporary", true], "expected": {"delay": 30, "retry": true}}, {"args": [2, 4, "temporary", true], "expected": {"delay": 2, "retry": true}}]}
{"case_id": "DEBUG-04", "check_input_immutability": true, "counterexample": "def select_ready(jobs,completed):\n    return [j[\"id\"] for j in jobs if any(d in completed for d in j[\"deps\"])]\n", "critical_rule": [], "function": "select_ready", "kind": "code", "reference_code": "def select_ready(jobs,completed):\n    done=set(completed)\n    ready=[j for j in jobs if j[\"id\"] not in done and all(d in done for d in j[\"deps\"])]\n    return [j[\"id\"] for j in sorted(ready,key=lambda j:(-j[\"priority\"],j[\"id\"]))]\n", "reference_token_count": 70, "tests": [{"args": [[], []], "expected": []}, {"args": [[{"deps": [], "id": "a", "priority": 1}, {"deps": ["x", "y"], "id": "b", "priority": 5}, {"deps": ["x"], "id": "c", "priority": 2}], ["x"]], "expected": ["c", "a"]}, {"args": [[{"deps": [], "id": "z", "priority": 3}, {"deps": [], "id": "a", "priority": 3}], []], "expected": ["a", "z"]}, {"args": [[{"deps": [], "id": "a", "priority": 3}, {"deps": ["a"], "id": "b", "priority": 1}], ["a"]], "expected": ["b"]}, {"args": [[{"deps": ["x"], "id": "x", "priority": 9}], []], "expected": []}]}
